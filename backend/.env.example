# Copy this file to .env and adjust as needed.

# Path to the trained model pickle
MODEL_PATH=models/house_price.pkl

# Path to the JSON file listing the locations the model was trained on
LOCATIONS_PATH=models/locations.json

# Comma-separated list of origins allowed to call this API (CORS).
# The React dev server (Vite) runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173
